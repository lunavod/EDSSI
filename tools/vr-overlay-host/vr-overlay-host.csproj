<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The overlay half of EDSSI's VR HUD: it owns the SteamVR overlay and does nothing else.

    It lives outside the Electron app because openvr is a C++ API with no maintained Node binding,
    and a separate process keeps native code out of the asar: nothing to unpack, and a crash here
    can't take EDSSI down with it. It speaks the framed protocol in src/main/vr/protocol.ts over
    stdin, and reports what happened as JSON lines on stdout.

    openvr_api.cs is Valve's own generated binding, vendored — see README.md. openvr_api.dll is
    never shipped: Program.cs loads the one belonging to the installed SteamVR runtime, so the
    interface versions always match what is actually running.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>vr-overlay-host</AssemblyName>
    <RootNamespace>Edssi.VrOverlayHost</RootNamespace>
    <!-- Valve's generated binding is not our code and does not compile warning-clean. -->
    <NoWarn>$(NoWarn);CS0108;CS0649;CS8618;CS8600;CS8602;CS8603;CS8604;CS8605;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
