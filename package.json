{
  "name": "edssi",
  "version": "1.0.0",
  "private": true,
  "description": "Elite Dangerous Smart Support Interface",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fresh": "jiti scripts/dev-fresh.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "gen:journal-types": "node --experimental-strip-types scripts/generate-journal-types.ts && oxfmt src/shared/journal-events.generated.ts",
    "gen:recipes": "node --experimental-strip-types scripts/generate-recipe-data.ts && oxfmt src/shared/recipes.generated.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "install-electron",
    "send-session": "jiti scripts/send-session.ts",
    "hid": "jiti scripts/hid-axes.ts",
    "hid:build": "node-gyp rebuild --directory=native/hid-usages",
    "vr:shots": "node --experimental-strip-types scripts/vr-shots.ts",
    "vr:preview": "jiti scripts/vr-preview.ts",
    "vr:build": "dotnet build tools/vr-overlay-host/vr-overlay-host.csproj -c Release -o out/vr-overlay-host --nologo"
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "node-hid": "^3.4.0",
    "onnxruntime-node": "^1.30.0",
    "phonemizer": "^1.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.3",
    "electron-vite": "^6.0.0-beta.1",
    "jiti": "^2.7.0",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^6.1.13",
    "openai": "^7.15.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "productName": "EDSSI"
}
