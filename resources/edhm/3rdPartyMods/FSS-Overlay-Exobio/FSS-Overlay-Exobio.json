{
  "mod_name": "FSS-Overlay-Exobio",
  "author": "EDSSI",
  "description": "Marks the FSS bands where bodies that can have life show up (MR, HMC, R, I, RI).<br>Needs the FSS-Overlay mod's shaders; installed by EDSSI in its place.",
  "version": "1.0.0",
  "file": "FSS-Overlay-Exobio.ini",
  "file_full": null,
  "managed": true,
  "mod_type": "INIConfig",
  "read_me": "<h4 align='center'><b>FSS Exobio Overlay</b></h4><p align='left'>Marks the Metal Rich, High Metal Content, Rocky, Icy and Rocky Ice bands of the Filtered Spectral Analysis: the bodies where life can grow.</p><p align='left'>It draws through the shaders of the <a href='https://github.com/psychicEgg/EDHM/tree/main/Odyssey/3rdPartyMods/FSS-Overlay' target='_blank'>FSS Overlay Mod</a> by psychicEgg and Parduz, maintained by Fred89210.</p><p align='center'><image=Overlay-Exobio.png;size=100%;align=top></p>",
  "sections": [
    {
      "name": "Options",
      "title": "FSS Exobio Overlay Options",
      "ini_section": "Constants",
      "visible": true,
      "keys": [
        {
          "name": "Enable FSS Exobio Overlay",
          "type": "toggle",
          "key": "global $FSSexobioEnabled",
          "value": "1",
          "visible": true,
          "description": "Show the overlay in the FSS"
        },
        {
          "name": "Overlay Brightness",
          "type": "decimal",
          "key": "w6",
          "value": "1",
          "visible": true,
          "description": "Default = 1.0"
        }
      ]
    },
    {
      "name": "KeyToggle-FSS-Exobio-Enabled",
      "title": "Enable/Disable Keybind",
      "ini_section": "KeyToggle-FSS-Exobio-Enabled",
      "visible": true,
      "keys": [
        {
          "name": "Binding Key",
          "type": "key_binding",
          "key": "Key",
          "value": "0x8f",
          "visible": true,
          "description": "Turns the overlay on and off"
        }
      ]
    }
  ],
  "custom_types": [
    {
      "type": "key_binding",
      "name": "None",
      "value": "0x8f"
    },
    {
      "type": "key_binding",
      "name": "F1",
      "value": "no_modifiers F1"
    },
    {
      "type": "key_binding",
      "name": "F2",
      "value": "no_modifiers F2"
    },
    {
